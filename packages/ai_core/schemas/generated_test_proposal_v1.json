{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://releaseproof.invalid/schemas/generated-test-proposal-v1.json",
  "title": "GeneratedTestProposalV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_behavior",
    "rationale",
    "evidence_ids",
    "file_path",
    "patch",
    "commands",
    "expected_result",
    "risk",
    "test_adapter",
    "test_adapter_version",
    "generation"
  ],
  "properties": {
    "schema_version": {"const": "generated-test-proposal-v1"},
    "target_behavior": {"type": "string", "minLength": 1, "maxLength": 500},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "file_path": {"type": "string", "minLength": 1, "maxLength": 240},
    "patch": {"type": "string", "minLength": 1, "maxLength": 65536},
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "expected_result": {"type": "string", "minLength": 1, "maxLength": 1000},
    "risk": {"enum": ["low", "medium", "high"]},
    "test_adapter": {"type": "string", "minLength": 1, "maxLength": 64},
    "test_adapter_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_name",
        "model_id",
        "provider_adapter_version",
        "prompt_version",
        "prompt_sha256",
        "source_evidence_id"
      ],
      "properties": {
        "provider_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "model_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "provider_adapter_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "prompt_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_evidence_id": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    }
  }
}
